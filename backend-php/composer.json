{
    "name": "red-udeg/backend-php",
    "description": "API REST para Plataforma Red UdeG — MOD-AUTH, MOD-PORT, etc.",
    "type": "project",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^6.10",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.6",
        "respect/validation": "^2.3",
        "phpmailer/phpmailer": "^6.9",
        "predis/predis": "^2.2"
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "RedUdeg\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RedUdeg\\Pruebas\\": "tests/"
        }
    },
    "scripts": {
        "pruebas": "phpunit --testdox",
        "analizar": "phpstan analyse src --level=8"
    }
}
